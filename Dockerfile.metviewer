ARG BASE_REGISTRY=docker.io
ARG BASE_IMAGE=debian
ARG BASE_TAG=12-slim
FROM ${BASE_REGISTRY}/${BASE_IMAGE}:${BASE_TAG}

LABEL maintainer="John Halley Gotway <johnhg@ucar.edu>"

#
# Constants
# Original Tomcat Source:
#   https://archive.apache.org/dist/tomcat/tomcat-${TOMCAT_MAJOR_VERSION}/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz
#
ENV TOMCAT_MAJOR_VERSION=9
ENV TOMCAT_MINOR_VERSION=0.117
ENV TOMCAT_VERSION=${TOMCAT_MAJOR_VERSION}.${TOMCAT_MINOR_VERSION}
ENV TOMCAT_URL=https://dtcenter.ucar.edu/dfiles/code/METplus/MET/docker_data/apache-tomcat-${TOMCAT_VERSION}.tar.gz
ENV CATALINA_HOME=/opt/tomcat

ENV SQLITE3_URL=https://www.sqlite.org/2025/sqlite-autoconf-3500300.tar.gz

ENV PYTHON_VER=3.14.3

# Expose METviewer port
EXPOSE 8080

WORKDIR /tmp

# install system updates, required packages
# - Install Python packages needed for METplus Analysis Python tools
# - Remove packages containing Critical CVEs:
#   NAME         INSTALLED               FIXED IN    TYPE VULNERABILITY  SEVERITY EPSS %        RISK
#   zlib1g-dev   1:1.2.13.dfsg-1         (won't fix) deb  CVE-2023-45853 Critical 0.7% (70th)   0.6
#   libxml2      2.9.14+dfsg-1.3~deb12u2 (won't fix) deb  CVE-2025-49794 Critical < 0.1% (23rd) < 0.1
#   libxml2      2.9.14+dfsg-1.3~deb12u2 (won't fix) deb  CVE-2025-49796 Critical < 0.1% (18th) < 0.1
#   libfcgi-bin  2.4.2-2                 (won't fix) deb  CVE-2025-23016 Critical < 0.1% (11th) < 0.1
#   libfcgi0ldbl 2.4.2-2                 (won't fix) deb  CVE-2025-23016 Critical < 0.1% (11th) < 0.1
#

RUN \
     echo "Install system updates" &&\
     apt -y update && apt -y upgrade \
  && echo "Install required packages" &&\
     apt -y install ant build-essential equivs ghostscript git libffi-dev libssl-dev ksh \
                    mariadb-server openjdk-17-jdk r-base wget &&\
     apt clean \
 && echo "Downloading and installing sqlite3 from ${SQLITE3_URL}" &&\
    wget ${SQLITE3_URL} &&\
    filename=$(basename ${SQLITE3_URL}) &&\
    tar xzf ${filename} &&\
    (cd ${filename%%.*} && ./configure && make -j $(nproc) && make install) &&\
    echo "/usr/local/lib" > /etc/ld.so.conf.d/usr-local.conf && ldconfig \
 && echo "Create dummy packages to prevent reinstallation of packages with CVEs" &&\
    ( \
        echo 'Package: libsqlite3-0'; \
        echo 'Version: 9:9.9.9'; \
        echo 'Architecture: amd64'; \
        echo 'Maintainer: Dummy Pkg'; \
        echo 'Description: Dummy package to satisfy libnss3 dependency with source-built sqlite3'; \
    ) > /tmp/libsqlite3-0.control && \
    equivs-build /tmp/libsqlite3-0.control &&\
    dpkg -i libsqlite3-0_9.9.9_amd64.deb \
  && echo "Setup default cran repo" &&\
     echo "r <- getOption('repos'); r['CRAN'] <- 'http://cran.us.r-project.org'; options(repos = r);" > ~/.Rprofile \
  && echo "Install required R packages" &&\
     Rscript -e "install.packages('boot')" &&\
     Rscript -e "install.packages('plotrix')" &&\
     Rscript -e "install.packages('gsl')" &&\
     Rscript -e "install.packages('data.table')" &&\
     Rscript -e "install.packages('verification')" \
  && echo "Install Tomcat" &&\
     wget ${TOMCAT_URL} &&\
     tar -xvf apache-tomcat-${TOMCAT_VERSION}.tar.gz &&\
     rm apache-tomcat*.tar.gz &&\
     mv apache-tomcat* ${CATALINA_HOME} &&\
     chmod +x ${CATALINA_HOME}/bin/*sh \
 && echo "Install Python from source" &&\
    wget https://www.python.org/ftp/python/${PYTHON_VER}/Python-${PYTHON_VER}.tgz &&\
    tar xzf Python-${PYTHON_VER}.tgz &&\
    (cd Python-${PYTHON_VER} &&\
    ./configure --enable-optimizations --enable-shared --disable-test-modules \
      LDFLAGS="-L/usr/local/lib -Wl,-rpath,/usr/local/lib" &&\
    make -j `nproc` &&\
    make install) &&\
    ln -s /usr/local/bin/python3 /usr/local/bin/python &&\
    rm -rf Python-${PYTHON_VER}* \
  && echo "Create a link for python3" &&\
     ln -sf /usr/local/bin/python3  /usr/bin/python3 &&\
     ln -sf /usr/bin/python3  /usr/bin/python &&\
     ln -sf /usr/local/bin/pip3  /usr/bin/pip3 &&\
     ln -sf /usr/bin/pip3  /usr/bin/pip \
  && echo "Create dummy python3 package to prevent installation of python3.11 with chrome" &&\
     ( \
        echo 'Package: python3'; \
        echo "Version: ${PYTHON_VER}"; \
        echo 'Architecture: amd64'; \
        echo 'Maintainer: Dummy Pkg'; \
        echo 'Description: Dummy package to satisfy chrome dependency'; \
        echo 'Provides: python3, python3.11, python3-minimal, python3.11-minimal,' \
             'libpython3.11, libpython3.11-minimal, libpython3-stdlib, libpython3.11-stdlib'; \
     ) > /tmp/python3.control && \
     equivs-build /tmp/python3.control &&\
     dpkg -i python3_${PYTHON_VER}_amd64.deb \
  && echo "Install GEOS - needed for cartopy" &&\
     wget http://download.osgeo.org/geos/geos-3.7.2.tar.bz2 && tar xjf geos-3.7.2.tar.bz2 &&\
     (cd geos-3.7.2 && ./configure && make clean && make && make install && ldconfig) &&\
     rm -r geos-3.7.2.tar.bz2 \
  && echo "Install Python packages" \
  && pip install cartopy \
  && pip install eofs \
  && pip install imutils \
  && pip install imageio \
  && pip install lxml \
  && pip install matplotlib \
  && pip install netcdf4 \
  && pip install numpy \
  && pip install pytest \
  && pip install metpy \
  && pip install pyyaml \
  && pip install scikit-image \
  && pip install scikit-learn \
  && pip install scipy \
  && pip install xarray \
  && pip install PyMySQL \
  && pip install pint \
  && pip install plotly \
  && pip install kaleido \
  && pip install attrs \
  && pip install exceptiongroup \
  && pip install iniconfig \
  && pip install packaging \
  && pip install pluggy \
  && pip install pytz \
  && pip install setuptools \
  && pip install six \
  && pip install tomli \
  && pip install wheel \
  && pip install python-dateutil \
  && pip install opencv-python \
  && pip install "pandas>=2.3.3,<3" \
  && echo "Install chrome for plotly/kaleido" &&\
     wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb &&\
     apt-get install -y ./google-chrome-stable_current_amd64.deb \
  && echo "removing packages containing critical CVEs" &&\
     apt remove -y zlib1g-dev libaom3 libfcgi-bin libfcgi0ldbl libpython3.11-minimal \
  && apt clean
